[global_group]

obstacles="Parking game: nodes the player's car reports hitting, via Obstacle.kind_of()."
npc_vehicles="Parking game: cars the traffic spawner parked. Cleared between rounds."
npc_living="Parking game: pedestrians and other living obstacles. Cleared between rounds."
building_entrance="Parking game: where pedestrians on foot are walking to. One per lot."
player_car="Parking game: the car the player drives. The lot's areas test for this rather than for a type."
respawn="Parking game: where PlayerCar.respawn() puts the car. One per lot."

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
